Attribute VB_Name = "SecondColor"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True

Private Sub Color_Change(Index As Integer)
Changed = True
If Val(Color(Index).Text) < 0 Then Color(Index).Text = 0
If Val(Color(Index).Text) > 255 Then Color(Index).Text = 255
ColorScroll(Index).Value = Val(Color(Index).Text)
Call C_ColorValue.Show(ColorShow, ColorCode, Val(Color(0).Text), Val(Color(1).Text), Val(Color(2).Text))
End Sub

Private Sub ColorScroll_Change(Index As Integer)
Changed = True
Color(Index).Text = ColorScroll(Index).Value
Call C_ColorValue.Show(ColorShow, ColorCode, Val(Color(0).Text), Val(Color(1).Text), Val(Color(2).Text))
End Sub

Private Sub ColorScroll_Scroll(Index As Integer)
Changed = True
Color(Index).Text = ColorScroll(Index).Value
Call C_ColorValue.Show(ColorShow, ColorCode, Val(Color(0).Text), Val(Color(1).Text), Val(Color(2).Text))
End Sub

Private Sub PropertyPage_ApplyChanges()
SelectedControls(0).SecondColor = Val(ColorShow.BackColor)
End Sub


Private Sub PropertyPage_SelectionChanged()
ColorCode.Caption = SelectedControls(0).SecondColor
Call RGBChange(SelectedControls(0).FirstColor, Color(0).Text, Color(1).Text, Color(2).Text)
End Sub


